---
import type { CollectionEntry } from 'astro:content';

interface Props {
	posts: CollectionEntry<'tech'>[];
}

const { posts } = Astro.props;
---

<ul class="post-list" data-post-list>
	{posts.map((post) => (
		<li
			class="post-card"
			data-post-card
			data-title={post.data.title.toLowerCase()}
			data-tags={post.data.tags.join(',').toLowerCase()}
		>
			<a class="post-card-link" href={`${import.meta.env.BASE_URL}tech/${post.id}/`}>
				<div class="post-card-banner" aria-hidden="true"></div>
				<div class="post-card-body">
					<time class="post-date">{post.data.created_at.toISOString().slice(0, 10)}</time>
					<span class="post-title">{post.data.title}</span>
				</div>
			</a>
			{post.data.tags.length > 0 && (
				<ul class="tag-list post-card-tags">
					{post.data.tags.map((tag) => (
						<li>
							<a class="tag-pill" href={`${import.meta.env.BASE_URL}tags/${tag}/`}>
								{tag}
							</a>
						</li>
					))}
				</ul>
			)}
		</li>
	))}
</ul>
<p class="no-results" data-no-results hidden>該当する記事が見つかりませんでした。</p>

<style>
	.no-results {
		color: var(--color-text-muted);
		font-size: 0.9rem;
		padding: 1rem 0;
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.1rem;
	}

	@media (max-width: 640px) {
		.post-list {
			grid-template-columns: 1fr;
		}
	}

	.post-card {
		position: relative;
		min-width: 0;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 14px;
		box-shadow: var(--shadow-card);
		overflow: hidden;
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
	}

	.post-card[hidden] {
		display: none;
	}

	.post-card:hover {
		transform: translateY(-2px);
		border-color: var(--color-accent);
		box-shadow: var(--shadow-card-hover);
	}

	.post-card-link {
		display: block;
		color: var(--color-text);
		text-decoration: none;
	}

	.post-card-link:hover {
		text-decoration: none;
	}

	/* カード全体（タグ部分を除く）をクリック可能にするため、リンクをカード全体に見えない状態で重ねる */
	.post-card-link::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.post-card-banner {
		height: 84px;
		background-color: var(--color-banner-bg);
		background-image:
			linear-gradient(to top right, rgba(0, 0, 0, 0.85), transparent 65%),
			repeating-linear-gradient(45deg, var(--color-banner-line) 0, var(--color-banner-line) 1px, transparent 1px, transparent 18px),
			repeating-linear-gradient(-45deg, var(--color-banner-line) 0, var(--color-banner-line) 1px, transparent 1px, transparent 18px);
	}

	.post-card-body {
		padding: 1rem 1.1rem 0.4rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.post-date {
		font-size: 0.75rem;
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	.post-title {
		font-weight: 600;
		font-size: 1rem;
		line-height: 1.4;
	}

	.post-card-tags {
		padding: 0.6rem 1.1rem 1.1rem;
	}
</style>
