---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('tech'))
	.filter((post) => post.data.publish)
	.sort((a, b) => b.data.created_at.valueOf() - a.data.created_at.valueOf());

const [latest, ...rest] = posts;
---

<BaseLayout title="記事一覧">
	<input
		slot="header-search"
		type="search"
		class="search-input"
		placeholder="タイトル・タグで検索..."
		data-search-input
	/>
	<main>
		<h1 class="sr-only">記事一覧</h1>

		{latest && (
			<div
				class="hero-card"
				data-post-card
				data-title={latest.data.title.toLowerCase()}
				data-tags={latest.data.tags.join(',').toLowerCase()}
			>
				<a class="hero-card-link" href={`${import.meta.env.BASE_URL}tech/${latest.id}/`}>
					<div class="hero-banner" aria-hidden="true"></div>
					<div class="hero-body">
						<span class="hero-eyebrow">Latest</span>
						<h2 class="hero-title">{latest.data.title}</h2>
						<time class="hero-date">{latest.data.created_at.toISOString().slice(0, 10)}</time>
					</div>
				</a>
				{latest.data.tags.length > 0 && (
					<ul class="tag-list hero-tags">
						{latest.data.tags.map((tag) => (
							<li>
								<a class="tag-pill" href={`${import.meta.env.BASE_URL}tags/${tag}/`}>
									{tag}
								</a>
							</li>
						))}
					</ul>
				)}
			</div>
		)}

		<PostList posts={rest} />
	</main>
</BaseLayout>

<script>
	// ClientRouterによるページ遷移のたびに再実行されるよう、astro:page-loadで初期化する
	document.addEventListener('astro:page-load', () => {
		const input = document.querySelector<HTMLInputElement>('[data-search-input]');
		const cards = document.querySelectorAll<HTMLElement>('[data-post-card]');
		const noResults = document.querySelector<HTMLElement>('[data-no-results]');

		input?.addEventListener('input', () => {
			const query = input.value.trim().toLowerCase();
			let visibleCount = 0;

			cards.forEach((card) => {
				const title = card.dataset.title ?? '';
				const tags = card.dataset.tags ?? '';
				const matches = query === '' || title.includes(query) || tags.includes(query);
				card.hidden = !matches;
				if (matches) visibleCount++;
			});

			if (noResults) {
				noResults.hidden = visibleCount > 0;
			}
		});
	});
</script>

<style>
	main {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 2.5rem 1.5rem 4rem;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.search-input {
		width: 100%;
		max-width: 240px;
		min-width: 0;
		font: inherit;
		font-size: 0.85rem;
		color: var(--color-text);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		padding: 0.45rem 0.8rem;
		outline: none;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.search-input::placeholder {
		color: var(--color-text-muted);
	}

	.search-input:focus {
		border-color: var(--color-accent);
		box-shadow: 0 0 0 3px var(--color-accent-soft);
	}

	.hero-card {
		position: relative;
		margin-bottom: 1.1rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 16px;
		overflow: hidden;
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
	}

	.hero-card[hidden] {
		display: none;
	}

	.hero-card:hover {
		transform: translateY(-2px);
		border-color: var(--color-accent);
		box-shadow: var(--shadow-card-hover);
	}

	.hero-card-link {
		display: block;
		color: var(--color-text);
		text-decoration: none;
	}

	.hero-card-link:hover {
		text-decoration: none;
	}

	/* カード全体をクリック可能にするため、リンクをカード全体に見えない状態で重ねる */
	.hero-card-link::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.hero-banner {
		height: 180px;
		background-color: var(--color-banner-bg);
		background-image:
			linear-gradient(to top right, rgba(0, 0, 0, 0.85), transparent 65%),
			repeating-linear-gradient(45deg, var(--color-banner-line) 0, var(--color-banner-line) 1px, transparent 1px, transparent 22px),
			repeating-linear-gradient(-45deg, var(--color-banner-line) 0, var(--color-banner-line) 1px, transparent 1px, transparent 22px);
	}

	.hero-body {
		padding: 1.5rem 1.75rem 1.1rem;
	}

	.hero-eyebrow {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin-bottom: 0.6rem;
	}

	.hero-title {
		font-size: 1.6rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.4;
		margin: 0 0 0.9rem;
	}

	.hero-date {
		font-size: 0.85rem;
		color: var(--color-text-muted);
	}

	.hero-tags {
		position: relative;
		z-index: 1;
		padding: 0 1.75rem 1.5rem;
	}
</style>
