---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getSlug } from '../lib/slug';

export async function getStaticPaths() {
	const posts = (await getCollection('tech')).filter((post) => post.data.publish);
	return posts.map((post) => ({
		params: { slug: getSlug(post) },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const slug = getSlug(post);
---

<BaseLayout title={post.data.title}>
	<main>
		<nav class="breadcrumb" aria-label="パンくずリスト">
			<a href={import.meta.env.BASE_URL}>posts</a>
			<span class="breadcrumb-sep">/</span>
			<span class="breadcrumb-current">{slug}</span>
		</nav>

		<div class="detail-banner" aria-hidden="true"></div>

		<div class="detail-layout">
			<article>
				<header class="post-header">
					<h1>{post.data.title}</h1>
					<div class="post-meta">
						<time>{post.data.created_at.toISOString().slice(0, 10)}</time>
						{post.data.tags.length > 0 && (
							<ul class="tag-list">
								{post.data.tags.map((tag) => (
									<li>
										<a class="tag-pill" href={`${import.meta.env.BASE_URL}tags/${tag}/`}>
											{tag}
										</a>
									</li>
								))}
							</ul>
						)}
					</div>
				</header>
				<Content />
			</article>

			<aside class="sidebar">
				{toc.length > 0 && (
					<div class="sidebar-section">
						<h2 class="sidebar-heading">Contents</h2>
						<ul class="toc-list">
							{toc.map((heading) => (
								<li class={`toc-item toc-depth-${heading.depth}`}>
									<a href={`#${heading.slug}`}>{heading.text}</a>
								</li>
							))}
						</ul>
					</div>
				)}
				{post.data.tags.length > 0 && (
					<div class="sidebar-section">
						<h2 class="sidebar-heading">Tags</h2>
						<ul class="tag-list">
							{post.data.tags.map((tag) => (
								<li>
									<a class="tag-pill" href={`${import.meta.env.BASE_URL}tags/${tag}/`}>
										{tag}
									</a>
								</li>
							))}
						</ul>
					</div>
				)}
			</aside>
		</div>
	</main>
</BaseLayout>

<script>
	// 目次(Contents)で、現在読んでいるセクションをハイライトする(scrollspy)
	let tocObserver: IntersectionObserver | null = null;
	let tocScrollHandler: (() => void) | null = null;

	function setupTocScrollSpy() {
		tocObserver?.disconnect();
		if (tocScrollHandler) {
			window.removeEventListener('scroll', tocScrollHandler);
			tocScrollHandler = null;
		}

		const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc-item a')];
		if (tocLinks.length === 0) return;

		const linkBySlug = new Map<string, HTMLAnchorElement>();
		tocLinks.forEach((link) => {
			const targetId = link.getAttribute('href')?.slice(1);
			if (targetId) linkBySlug.set(targetId, link);
		});

		function setActive(link: HTMLAnchorElement | undefined) {
			tocLinks.forEach((l) => l.classList.remove('active'));
			link?.classList.add('active');
		}

		// 初期表示では先頭のセクションをアクティブにしておく
		setActive(tocLinks[0]);

		const headerHeight =
			parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) ||
			80;

		// クリック直後はスムーススクロール中の判定が意図しない項目を拾ってしまうため、
		// 少しの間だけobserver/scrollによる自動更新を止めてクリックした項目を優先する
		let suppressUntil = 0;

		tocObserver = new IntersectionObserver(
			(entries) => {
				if (Date.now() < suppressUntil) return;
				entries.forEach((entry) => {
					const link = linkBySlug.get(entry.target.id);
					if (!link || !entry.isIntersecting) return;
					setActive(link);
				});
			},
			{
				rootMargin: `-${headerHeight + 16}px 0px -75% 0px`,
				threshold: 0,
			}
		);

		linkBySlug.forEach((_, id) => {
			const heading = document.getElementById(id);
			if (heading) tocObserver!.observe(heading);
		});

		// 末尾の見出しは、その下に十分な余白がないとobserverの監視帯に入らずアクティブにならない。
		// ページ最下部までスクロールした場合は最後の項目を強制的にアクティブにする
		tocScrollHandler = () => {
			if (Date.now() < suppressUntil) return;
			const atBottom =
				window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
			if (atBottom) setActive(tocLinks[tocLinks.length - 1]);
		};
		window.addEventListener('scroll', tocScrollHandler, { passive: true });

		// クリック時は即座にその項目をアクティブにする
		tocLinks.forEach((link) => {
			link.addEventListener('click', () => {
				setActive(link);
				suppressUntil = Date.now() + 700;
			});
		});
	}

	document.addEventListener('astro:page-load', setupTocScrollSpy);
</script>

<style>
	main {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 2.5rem 1.5rem 4rem;
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 2rem;
		font-size: 0.85rem;
		font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
	}

	.breadcrumb a {
		color: var(--color-text-muted);
	}

	.breadcrumb a:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	.breadcrumb-sep {
		color: var(--color-border);
	}

	.breadcrumb-current {
		color: var(--color-text-muted);
	}

	.detail-banner {
		height: 80px;
		border-radius: 12px;
		margin-bottom: 2rem;
		background-color: var(--color-banner-bg);
		transition: background-color 0.2s ease;
		background-image:
			repeating-linear-gradient(45deg, var(--color-banner-line) 0, var(--color-banner-line) 1px, transparent 1px, transparent 18px),
			repeating-linear-gradient(-45deg, var(--color-banner-line) 0, var(--color-banner-line) 1px, transparent 1px, transparent 18px);
	}

	.detail-layout {
		display: grid;
		grid-template-columns: 1fr 220px;
		align-items: start;
		gap: 3rem;
	}

	.detail-layout > article {
		/* グリッドアイテムはデフォルトでmin-width: autoのため、
		   コードブロック等の横長コンテンツがあると画面幅を超えて広がってしまう。
		   0を指定して明示的に縮められるようにする */
		min-width: 0;
	}

	@media (max-width: 860px) {
		.detail-layout {
			grid-template-columns: 1fr;
		}
	}

	.post-header {
		margin-bottom: 2.5rem;
	}

	.post-header h1 {
		font-size: 1.9rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin: 0 0 0.9rem;
	}

	.post-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		font-size: 0.85rem;
		color: var(--color-text-muted);
	}

	.sidebar {
		position: sticky;
		top: calc(var(--header-height) + 1.5rem);
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	@media (max-width: 860px) {
		.sidebar {
			display: none;
		}
	}

	.sidebar-heading {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin: 0 0 0.75rem;
	}

	.toc-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		border-left: 1px solid var(--color-border);
	}

	.toc-item a {
		display: block;
		padding-left: 0.9rem;
		font-size: 0.85rem;
		color: var(--color-text-muted);
		line-height: 1.4;
	}

	.toc-item a:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	.toc-item a.active {
		color: var(--color-accent);
		font-weight: 600;
		box-shadow: -2px 0 0 var(--color-accent);
		transition: color 0.15s ease, box-shadow 0.15s ease;
	}

	.toc-depth-3 a {
		padding-left: 1.7rem;
		font-size: 0.8rem;
	}

	article :global(h2) {
		font-size: 1.35rem;
		margin-top: 2.5rem;
		padding-left: 0.75rem;
		border-left: 3px solid var(--color-accent);
		scroll-margin-top: calc(var(--header-height) + 1rem);
	}

	article :global(h3) {
		font-size: 1.1rem;
		margin-top: 2rem;
		scroll-margin-top: calc(var(--header-height) + 1rem);
	}

	article :global(p) {
		margin: 1rem 0;
	}

	article :global(table) {
		border-collapse: collapse;
		width: 100%;
		margin: 1.5rem 0;
	}

	article :global(th),
	article :global(td) {
		border: 1px solid var(--color-border);
		padding: 0.5rem 0.75rem;
		text-align: left;
	}

	article :global(blockquote) {
		margin: 1.5rem 0;
		padding: 0.25rem 1rem;
		border-left: 3px solid var(--color-accent);
		color: var(--color-text-muted);
	}
</style>
