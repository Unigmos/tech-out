---
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(function () {
				function systemTheme() {
					return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				function applyTheme(theme) {
					document.documentElement.setAttribute('data-theme', theme);
				}
				function initTheme() {
					const stored = localStorage.getItem('theme');
					applyTheme(stored ?? systemTheme());
				}

				initTheme();

				window
					.matchMedia('(prefers-color-scheme: dark)')
					.addEventListener('change', (e) => {
						if (!localStorage.getItem('theme')) {
							applyTheme(e.matches ? 'dark' : 'light');
						}
					});

				// ClientRouterでのページ遷移後もテーマを保持する
				document.addEventListener('astro:after-swap', initTheme);

				// ヘッダーが遷移で入れ替わっても効くよう、documentに委譲する
				document.addEventListener('click', (e) => {
					const target = e.target;
					if (!(target instanceof Element)) return;
					const btn = target.closest('[data-theme-toggle]');
					if (!btn) return;
					const current = document.documentElement.getAttribute('data-theme');
					const next = current === 'dark' ? 'light' : 'dark';
					localStorage.setItem('theme', next);
					applyTheme(next);
				});
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<ClientRouter />
	</head>
	<body>
		<header class="site-header">
			<a href={import.meta.env.BASE_URL} class="site-title">Tech Notes</a>
			<div class="header-actions">
				<slot name="header-search" />
				<button type="button" class="theme-toggle" data-theme-toggle aria-label="テーマを切り替え">
					<svg class="icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
						<circle cx="12" cy="12" r="4" />
						<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
					</svg>
					<svg class="icon icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
					</svg>
				</button>
			</div>
		</header>
		<slot />
	</body>
</html>

<script>
	// コードブロックにヘッダー（言語名＋コピーボタン）を追加する
	function enhanceCodeBlocks() {
		document.querySelectorAll<HTMLPreElement>('article pre[data-language]').forEach((pre) => {
			if (pre.parentElement?.classList.contains('code-block')) return;

			const wrapper = document.createElement('div');
			wrapper.className = 'code-block';

			const header = document.createElement('div');
			header.className = 'code-block-header';

			const lang = document.createElement('span');
			lang.className = 'code-lang';
			lang.textContent = pre.dataset.language ?? '';

			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'copy-btn';
			button.setAttribute('aria-label', 'コードをコピー');
			button.innerHTML =
				'<svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>' +
				'<svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';

			button.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(pre.innerText);
					button.classList.add('copied');
					setTimeout(() => button.classList.remove('copied'), 1500);
				} catch {
					// クリップボード権限がない場合等は静かに無視する
				}
			});

			header.append(lang, button);
			pre.replaceWith(wrapper);
			wrapper.append(header, pre);
		});
	}

	document.addEventListener('astro:page-load', enhanceCodeBlocks);

	// sticky固定したヘッダーの実際の高さをCSS変数にして、
	// サイドバーの位置や見出しへのスクロール時にヘッダーと重ならないようにする
	function updateHeaderHeight() {
		const header = document.querySelector<HTMLElement>('.site-header');
		if (!header) return;
		document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`);
	}

	document.addEventListener('astro:page-load', updateHeaderHeight);
	window.addEventListener('resize', updateHeaderHeight);
</script>

<style is:global>
	:root {
		--color-bg: #fafafa;
		--color-surface: #ffffff;
		--color-text: #1a1b1e;
		--color-text-muted: #6b7280;
		--color-border: #e5e7eb;
		--color-accent: #ea580c;
		--color-accent-soft: #ffedd5;
		--color-code-bg: #f6f8fa;
		--color-banner-bg: #14151a;
		--color-banner-line: rgba(234, 88, 12, 0.4);
		--content-width: 1040px;
		--header-height: 89px;
		--shadow-card: 0 1px 2px rgba(16, 24, 40, 0.04);
		--shadow-card-hover: 0 12px 24px -8px rgba(234, 88, 12, 0.25);
	}

	@media (prefers-color-scheme: dark) {
		:root:not([data-theme]) {
			--color-bg: #101114;
			--color-surface: #191a1f;
			--color-text: #e5e7eb;
			--color-text-muted: #9099a8;
			--color-border: #2b2d33;
			--color-accent: #fb923c;
			--color-accent-soft: rgba(251, 146, 60, 0.15);
			--color-code-bg: #1c1e24;
			--color-banner-bg: #0c0d10;
			--color-banner-line: rgba(251, 146, 60, 0.35);
			--shadow-card: 0 1px 2px rgba(0, 0, 0, 0.3);
			--shadow-card-hover: 0 12px 24px -8px rgba(251, 146, 60, 0.3);
		}
	}

	:root[data-theme='dark'] {
		--color-bg: #101114;
		--color-surface: #191a1f;
		--color-text: #e5e7eb;
		--color-text-muted: #9099a8;
		--color-border: #2b2d33;
		--color-accent: #fb923c;
		--color-accent-soft: rgba(251, 146, 60, 0.15);
		--color-code-bg: #1c1e24;
		--color-banner-bg: #0c0d10;
		--color-banner-line: rgba(251, 146, 60, 0.35);
		--shadow-card: 0 1px 2px rgba(0, 0, 0, 0.3);
		--shadow-card-hover: 0 12px 24px -8px rgba(251, 146, 60, 0.3);
	}

	* {
		box-sizing: border-box;
	}

	html {
		font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI",
			"Hiragino Kaku Gothic ProN", "Hiragino Sans", Meiryo, Roboto, sans-serif;
	}

	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}

	body {
		margin: 0;
		background: var(--color-bg);
		color: var(--color-text);
		line-height: 1.75;
		-webkit-font-smoothing: antialiased;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 1.5rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex: 1;
		min-width: 0;
		justify-content: flex-end;
	}

	.site-title {
		flex-shrink: 0;
		font-weight: 700;
		font-size: 1.05rem;
		letter-spacing: -0.01em;
		color: var(--color-text) !important;
	}

	.site-title:hover {
		color: var(--color-accent) !important;
		text-decoration: none;
	}

	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.1rem;
		height: 2.1rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-surface);
		color: var(--color-text-muted);
		cursor: pointer;
		padding: 0;
		transition: border-color 0.15s ease, color 0.15s ease;
	}

	.theme-toggle:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.theme-toggle .icon {
		width: 1.05rem;
		height: 1.05rem;
	}

	.theme-toggle .icon-moon {
		display: block;
	}

	.theme-toggle .icon-sun {
		display: none;
	}

	:root[data-theme='dark'] .theme-toggle .icon-moon {
		display: none;
	}

	:root[data-theme='dark'] .theme-toggle .icon-sun {
		display: block;
	}

	a {
		color: var(--color-accent);
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}

	img {
		max-width: 100%;
		height: auto;
		border-radius: 10px;
	}

	code {
		font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
		background: var(--color-code-bg);
		padding: 0.15em 0.4em;
		border-radius: 4px;
		font-size: 0.9em;
	}

	pre {
		background: var(--color-code-bg);
		border: 1px solid var(--color-border);
		padding: 1rem;
		border-radius: 10px;
		overflow-x: auto;
	}

	pre code {
		background: none;
		padding: 0;
	}

	/* コードブロック（言語ラベル＋コピーボタン付き） */
	.code-block {
		margin: 1.5rem 0;
		border: 1px solid var(--color-border);
		border-radius: 10px;
		overflow: hidden;
	}

	.code-block-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem 0.9rem;
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
	}

	.code-lang {
		font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.copy-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.8rem;
		height: 1.8rem;
		border: none;
		border-radius: 6px;
		background: transparent;
		color: var(--color-text-muted);
		cursor: pointer;
		padding: 0;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.copy-btn:hover {
		background: var(--color-accent-soft);
		color: var(--color-accent);
	}

	.copy-btn svg {
		width: 0.95rem;
		height: 0.95rem;
	}

	.copy-btn .icon-check {
		display: none;
		color: #16a34a;
	}

	.copy-btn.copied .icon-copy {
		display: none;
	}

	.copy-btn.copied .icon-check {
		display: block;
	}

	.code-block pre {
		margin: 0;
		border: none;
		border-radius: 0;
	}

	.tag-list {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
	}

	.tag-pill {
		position: relative;
		z-index: 1;
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--color-accent);
		background: var(--color-accent-soft);
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		text-decoration: none;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.tag-pill:hover {
		background: var(--color-accent);
		color: var(--color-surface);
		text-decoration: none;
	}
</style>
