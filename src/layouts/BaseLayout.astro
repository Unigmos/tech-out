---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="site-header">
			<a href={import.meta.env.BASE_URL} class="site-title">Tech Notes</a>
		</header>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--color-bg: #fafafa;
		--color-surface: #ffffff;
		--color-text: #1a1b1e;
		--color-text-muted: #6b7280;
		--color-border: #e5e7eb;
		--color-accent: #6366f1;
		--color-accent-soft: #eef2ff;
		--color-code-bg: #f6f8fa;
		--content-width: 720px;
		--shadow-card: 0 1px 2px rgba(16, 24, 40, 0.04);
		--shadow-card-hover: 0 12px 24px -8px rgba(99, 102, 241, 0.25);
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--color-bg: #101114;
			--color-surface: #191a1f;
			--color-text: #e5e7eb;
			--color-text-muted: #9099a8;
			--color-border: #2b2d33;
			--color-accent: #818cf8;
			--color-accent-soft: rgba(129, 140, 248, 0.15);
			--color-code-bg: #1c1e24;
			--shadow-card: 0 1px 2px rgba(0, 0, 0, 0.3);
			--shadow-card-hover: 0 12px 24px -8px rgba(129, 140, 248, 0.35);
		}
	}

	* {
		box-sizing: border-box;
	}

	html {
		font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI",
			"Hiragino Kaku Gothic ProN", "Hiragino Sans", Meiryo, Roboto, sans-serif;
	}

	body {
		margin: 0;
		background: var(--color-bg);
		color: var(--color-text);
		line-height: 1.75;
		-webkit-font-smoothing: antialiased;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.site-header {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 1.5rem 1.5rem 0;
	}

	.site-title {
		font-weight: 700;
		font-size: 1.05rem;
		letter-spacing: -0.01em;
		color: var(--color-text) !important;
	}

	.site-title:hover {
		color: var(--color-accent) !important;
		text-decoration: none;
	}

	a {
		color: var(--color-accent);
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}

	img {
		max-width: 100%;
		height: auto;
		border-radius: 10px;
	}

	code {
		font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
		background: var(--color-code-bg);
		padding: 0.15em 0.4em;
		border-radius: 4px;
		font-size: 0.9em;
	}

	pre {
		background: var(--color-code-bg);
		border: 1px solid var(--color-border);
		padding: 1rem;
		border-radius: 10px;
		overflow-x: auto;
	}

	pre code {
		background: none;
		padding: 0;
	}

	.tag-list {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
	}

	.tag-pill {
		position: relative;
		z-index: 1;
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--color-accent);
		background: var(--color-accent-soft);
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		text-decoration: none;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.tag-pill:hover {
		background: var(--color-accent);
		color: var(--color-surface);
		text-decoration: none;
	}
</style>
